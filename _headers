# Cloudflare static assets headers (https://developers.cloudflare.com/workers/static-assets/headers/)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000

# CSS/JS are not fingerprinted, so keep the lifetime short enough that a deploy
# reaches users quickly. The service worker already revalidates over the network.
/css/*
  Cache-Control: public, max-age=600
/js/*
  Cache-Control: public, max-age=600

# Images and icons rarely change
/icons/*
  Cache-Control: public, max-age=604800
/og-image.png
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
